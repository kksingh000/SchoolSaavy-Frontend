# Base URL of the Laravel API, including the /api prefix.
# Local Laravel:   http://localhost:8000/api
# Render:          https://<your-service>.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: used only by `npm run dev` when VITE_API_BASE_URL is a relative path (/api).
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Shown in the sidebar footer / login card.
VITE_APP_NAME=SchoolSaavy
